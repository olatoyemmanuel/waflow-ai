# Application
APP_NAME=WAFlow AI
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_DB=waflow
POSTGRES_USER=waflow
POSTGRES_PASSWORD=waflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://waflow:waflow@localhost:5433/waflow

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# OpenAI
OPENAI_API_KEY=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=waflow

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
